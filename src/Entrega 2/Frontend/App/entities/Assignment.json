{
  "name": "Assignment",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string",
      "title": "ID do Dispositivo"
    },
    "technician_email": {
      "type": "string",
      "title": "E-mail do T\u00e9cnico"
    },
    "technician_name": {
      "type": "string",
      "title": "Nome do T\u00e9cnico"
    },
    "ctc_code": {
      "type": "string",
      "title": "C\u00f3digo de T\u00e9cnico"
    },
    "connection_status": {
      "type": "string",
      "enum": [
        "pendente",
        "conectando",
        "conectado",
        "falha"
      ],
      "title": "Status de Conex\u00e3o"
    },
    "wifi_tested": {
      "type": "boolean",
      "title": "WiFi Testado"
    },
    "last_ping": {
      "type": "string",
      "title": "\u00daltimo Ping"
    },
    "active": {
      "type": "boolean",
      "title": "Ativo"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovado",
        "rejeitado"
      ],
      "title": "Aprova\u00e7\u00e3o do T\u00e9cnico",
      "default": "pendente"
    }
  },
  "required": [
    "device_id",
    "technician_email",
    "connection_status",
    "active"
  ]
}