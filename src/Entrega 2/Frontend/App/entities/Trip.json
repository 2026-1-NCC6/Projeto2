{
  "name": "Trip",
  "type": "object",
  "properties": {
    "technician_name": {
      "type": "string",
      "title": "Nome do T\u00e9cnico"
    },
    "technician_email": {
      "type": "string",
      "title": "E-mail do T\u00e9cnico"
    },
    "box_id": {
      "type": "string",
      "title": "ID da Caixa T\u00e9rmica"
    },
    "route_name": {
      "type": "string",
      "title": "Nome da Rota"
    },
    "origin": {
      "type": "string",
      "title": "Origem"
    },
    "destination": {
      "type": "string",
      "title": "Destino"
    },
    "current_temp": {
      "type": "number",
      "title": "Temperatura Atual (\u00b0C)"
    },
    "current_humidity": {
      "type": "number",
      "title": "Umidade Atual (%)"
    },
    "temp_history": {
      "type": "array",
      "title": "Hist\u00f3rico de Temperatura",
      "items": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string"
          },
          "temp": {
            "type": "number"
          },
          "humidity": {
            "type": "number"
          }
        }
      }
    },
    "alert_count": {
      "type": "number",
      "title": "Quantidade de Alertas",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "em_transito",
        "entregue",
        "sinistro"
      ],
      "title": "Status"
    },
    "vehicle": {
      "type": "string",
      "title": "Ve\u00edculo"
    },
    "started_at": {
      "type": "string",
      "title": "In\u00edcio da Viagem"
    },
    "ended_at": {
      "type": "string",
      "title": "Fim da Viagem"
    },
    "post_trip_notes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es P\u00f3s-Viagem"
    }
  },
  "required": [
    "technician_name",
    "technician_email",
    "box_id",
    "route_name",
    "status"
  ]
}